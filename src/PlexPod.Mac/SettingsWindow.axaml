<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlexPod.App.ViewModels;assembly=PlexPod.App.Shared"
        x:Class="PlexPod.Mac.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="PlexPod settings" Width="620" Height="720" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:TagFieldViewModel">
            <CheckBox IsChecked="{Binding IsOn}" Margin="0,2" Content="{Binding DisplayName}" />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Close" MinWidth="90" IsCancel="True" IsDefault="True"
                Margin="0,12,0,0" Click="OnClose" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ffmpeg" Classes="heading" />
                <TextBlock Text="Used to convert hi-res FLAC and to verify every file. PlexPod never downloads or bundles it. It needs soxr, which Homebrew's plain ffmpeg lacks: brew tap homebrew-ffmpeg/ffmpeg, then brew install homebrew-ffmpeg/ffmpeg/ffmpeg --with-libsoxr"
                           Classes="hint" Margin="0,2,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Detect" Command="{Binding DetectCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding FfmpegPath}"
                             PlaceholderText="Leave empty to find ffmpeg automatically (PATH, then Homebrew)"
                             AutomationProperties.Name="ffmpeg path" />
                </DockPanel>
                <TextBlock Text="{Binding FfmpegStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="Plays and ratings" Classes="heading" Margin="0,18,0,0" />
                <CheckBox IsChecked="{Binding StatsReturn}" Margin="0,4,0,0"
                          Content="Send plays and ratings from the iPod to Plex at every sync" />
                <TextBlock Classes="hint" Margin="0,4,0,6"
                           Text="Plays are recorded only with Rockbox's Settings → Playback Settings → Logging turned on, and count when at least 90% of the track was played. Ratings reach Plex after Settings → General Settings → Database → Export Modifications on the iPod. Rockbox's own files are only read, never changed." />
                <StackPanel IsEnabled="{Binding StatsReturn}">
                    <TextBlock Text="Ratings from the iPod" FontWeight="SemiBold" Margin="0,2,0,2" />
                    <RadioButton GroupName="Ratings" IsChecked="{Binding RatingsIpodWins}" Margin="0,2"
                                 Content="iPod changes win: a rating changed on the iPod replaces the one in Plex" />
                    <RadioButton GroupName="Ratings" IsChecked="{Binding RatingsFillGapsOnly}" Margin="0,2"
                                 Content="Only fill gaps: sent only for tracks with no rating in Plex" />
                </StackPanel>

                <TextBlock Text="Conversion cache" Classes="heading" Margin="0,18,0,0" />
                <TextBlock Text="Converted hi-res files are kept so a tag change in Plex never re-converts. The oldest are removed above the cap."
                           Classes="hint" Margin="0,2,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding CacheCapGb}" Width="70" AutomationProperties.Name="Cache cap in GB" />
                    <TextBlock Text="GB" VerticalAlignment="Center" Margin="6,0,12,0" />
                    <TextBlock Text="{Binding CacheUsage}" VerticalAlignment="Center" Opacity="0.75" />
                </StackPanel>

                <DockPanel Margin="0,18,0,0">
                    <Button DockPanel.Dock="Right" Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" />
                    <TextBlock Text="Tags written to the iPod" Classes="heading" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Classes="hint" Margin="0,2,0,6"
                           Text="Every copy starts with all tags wiped. Unticked fields are left out entirely, so junk in them never reaches the iPod. Changes apply at the next sync or export." />
                <TextBlock Text="{Binding CoreWarning}" TextWrapping="Wrap" Classes="warning" Margin="0,0,0,6"
                           IsVisible="{Binding CoreWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Text="From Plex" FontWeight="SemiBold" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding PlexFields}" />

                <TextBlock Text="Kept from the original file (Plex doesn't store these)" FontWeight="SemiBold" Margin="0,10,0,2" />
                <ItemsControl ItemsSource="{Binding FileFields}" />

                <TextBlock Classes="hint" Margin="0,10,0,0"
                           Text="PlexPod's own ID tags (PLEXPOD_RATINGKEY, PLEXPOD_GUID, PLEXPOD_PARTID) are always written. Syncing and play-count return depend on them, and Rockbox ignores them." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
