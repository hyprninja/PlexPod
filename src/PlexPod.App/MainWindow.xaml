<Window x:Class="PlexPod.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PlexPod.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PlexPod" Width="980" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- One picker: filter box, Select all / Clear, and a virtualised checkbox list. -->
        <DataTemplate x:Key="PickerTemplate" DataType="{x:Type vm:PickerListViewModel}">
            <Grid IsEnabled="{Binding IsEnabled}" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Select all" Command="{Binding SelectAllCommand}" Margin="6,0,0,0"
                            ToolTip="Selects every item that matches the filter" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ToolTip="Filter" AutomationProperties.Name="Filter" />
                </DockPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding View}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="MinHeight" Value="32" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PickerItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                                <Border Grid.Column="1" Margin="8,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding Badge, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: sign-in, server, library, refresh. -->
        <StackPanel Grid.Row="0">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="Sign in with Plex" Command="{Binding SignIn.SignInCommand}" Margin="0,0,8,4"
                        Visibility="{Binding SignIn.IsSignedOut, Converter={StaticResource VisibleWhen}}" />
                <Button Content="Cancel" Command="{Binding SignIn.SignInCancelCommand}" Margin="0,0,8,4"
                        Visibility="{Binding SignIn.SignInCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center"
                            Visibility="{Binding SignIn.IsSignedIn, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding SignIn.Username, TargetNullValue='Signed in'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="Sign out" Command="{Binding SignIn.SignOutCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding Server.Servers}" SelectedItem="{Binding Server.SelectedServer}"
                          DisplayMemberPath="Name" MinWidth="180" Margin="0,0,16,4" AutomationProperties.Name="Server" />
                <TextBlock Text="Library" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding Server.Sections}" SelectedItem="{Binding Server.SelectedSection}"
                          DisplayMemberPath="Title" MinWidth="140" Margin="0,0,16,4" AutomationProperties.Name="Library" />
                <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,4" />
                <Button Content="⚙ Settings" Click="OnOpenSettings" Margin="0,0,0,4" />
            </WrapPanel>

            <TextBlock Text="{Binding SignIn.Status}" Margin="0,2" TextWrapping="Wrap"
                       Visibility="{Binding SignIn.Status, Converter={StaticResource VisibleWhen}}" />

            <Expander Header="Server address" Margin="0,4,0,0">
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Use this address" Command="{Binding ApplyServerUrlCommand}" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"
                               Text="{Binding Server.ConnectionText, StringFormat='Connected via {0}. Override:', TargetNullValue='Override:'}" />
                    <TextBox Text="{Binding Server.UrlOverride, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Leave empty to find the server automatically. Example: http://192.168.1.20:32400"
                             AutomationProperties.Name="Server URL override" />
                </DockPanel>
            </Expander>

            <!-- iPod -->
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding Device.DescriptionText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Device.WarningText}" TextWrapping="Wrap" Foreground="DarkOrange"
                           Visibility="{Binding Device.WarningText, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </StackPanel>

        <!-- All songs toggle -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0" IsEnabled="{Binding Selection.HasLibrary}">
            <CheckBox Content="All songs" IsChecked="{Binding Selection.AllSongs}" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Pickers -->
        <TabControl Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding Selection.HasLibrary}">
            <TabItem Header="{Binding Selection.Playlists.HeaderText}">
                <ContentControl Content="{Binding Selection.Playlists}" ContentTemplate="{StaticResource PickerTemplate}" />
            </TabItem>
            <TabItem Header="{Binding Selection.Artists.HeaderText}" IsEnabled="{Binding Selection.Artists.IsEnabled}">
                <ContentControl Content="{Binding Selection.Artists}" ContentTemplate="{StaticResource PickerTemplate}" />
            </TabItem>
            <TabItem Header="{Binding Selection.Albums.HeaderText}" IsEnabled="{Binding Selection.Albums.IsEnabled}">
                <ContentControl Content="{Binding Selection.Albums}" ContentTemplate="{StaticResource PickerTemplate}" />
            </TabItem>
        </TabControl>

        <!-- Summary -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar Height="10" Minimum="0" Maximum="1" Value="{Binding Summary.FillValue, Mode=OneWay}"
                         AutomationProperties.Name="Capacity">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.IsOver}" Value="True">
                                <Setter Property="Foreground" Value="#D13438" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Summary.BarText}" Margin="0,6,0,0" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.IsOver}" Value="True">
                                <Setter Property="Foreground" Value="#D13438" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Summary.BreakdownText}" Opacity="0.75" TextWrapping="Wrap" />
            <DockPanel Visibility="{Binding Summary.WarningText, Converter={StaticResource VisibleWhen}}" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Forget missing" Command="{Binding ForgetMissingCommand}" Margin="8,0,0,0"
                        Visibility="{Binding Selection.HasMissingRefs, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding Summary.WarningText}" TextWrapping="Wrap" Foreground="DarkOrange" VerticalAlignment="Center" />
            </DockPanel>

            <!-- The iPod carries a different saved selection (/.plexpod/selection.json). -->
            <DockPanel Margin="0,10,0,0" Visibility="{Binding Sync.DeviceSelectionHint, Converter={StaticResource VisibleWhen}}">
                <Button DockPanel.Dock="Right" Content="Load it" Command="{Binding Sync.LoadDeviceSelectionCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Sync.DeviceSelectionHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Sync (M3): progress and a safe Stop. -->
            <DockPanel Margin="0,10,0,0" Visibility="{Binding Sync.ProgressText, Converter={StaticResource VisibleWhen}}">
                <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding Sync.SyncCancelCommand}" Margin="8,0,0,0"
                        ToolTip="Finishes the file being copied, then stops. The iPod stays consistent."
                        Visibility="{Binding Sync.SyncCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
                <StackPanel>
                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Sync.ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding Sync.SyncCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Sync.ProgressText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Test export (M2): writes to a PC folder only. -->
            <DockPanel Margin="0,10,0,0" Visibility="{Binding Export.ProgressText, Converter={StaticResource VisibleWhen}}">
                <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding Export.OpenFolderCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Export.ExportCancelCommand}" Margin="8,0,0,0"
                        Visibility="{Binding Export.ExportCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
                <StackPanel>
                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Export.ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding Export.ExportCommand.IsRunning, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Export.ProgressText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Sync" Command="{Binding Sync.SyncCommand}" MinWidth="100"
                        ToolTip="Make the iPod match your selection. Shows the plan first; nothing changes until you confirm." />
                <Button DockPanel.Dock="Right" Content="Test export…" Command="{Binding Export.ExportCommand}" Margin="0,0,8,0"
                        ToolTip="Process the selection into a folder on this PC (converted, re-tagged, with art) to check before syncing." />
                <Button DockPanel.Dock="Right" Content="Send plays now" Command="{Binding Sync.SendPlaysNowCommand}" Margin="0,0,8,0"
                        ToolTip="Send plays and ratings recorded on the iPod to Plex, without syncing (Rockbox). Every sync does this first anyway, and on Apple's firmware only a sync can." ToolTipService.ShowOnDisabled="True" />
                <ProgressBar DockPanel.Dock="Left" Width="80" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
