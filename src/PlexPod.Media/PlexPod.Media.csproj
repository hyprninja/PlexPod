<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Two builds: net10.0-windows uses WIC (System.Windows.Media.Imaging) for baseline JPEG album art,
    as it always has; net10.0 (macOS) uses ImageIO. See Art/ImageCodec.*.cs.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlexPod.Core\PlexPod.Core.csproj" />
    <ProjectReference Include="..\PlexPod.Plex\PlexPod.Plex.csproj" />
    <ProjectReference Include="..\PlexPod.Device\PlexPod.Device.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlexPod.Tests" />
  </ItemGroup>

</Project>
