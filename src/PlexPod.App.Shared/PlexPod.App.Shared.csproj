<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The view models and services both apps share: the Windows app (WPF, PlexPod.App) and the Mac app
    (Avalonia, PlexPod.Mac). No UI framework here; each app implements the small seams in
    Services/PlatformSeams.cs. Namespaces stay PlexPod.App.* so the move didn't churn the code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlexPod.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlexPod.Core\PlexPod.Core.csproj" />
    <ProjectReference Include="..\PlexPod.Plex\PlexPod.Plex.csproj" />
    <ProjectReference Include="..\PlexPod.Device\PlexPod.Device.csproj" />
    <ProjectReference Include="..\PlexPod.Media\PlexPod.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlexPod.Tests" />
  </ItemGroup>

</Project>
