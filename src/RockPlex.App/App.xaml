<Application x:Class="RockPlex.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RockPlex.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent theme; follows the system light/dark setting. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VisibleWhenConverter x:Key="VisibleWhen" />
            <conv:VisibleWhenConverter x:Key="CollapsedWhen" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
